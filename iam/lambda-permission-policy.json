{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSiteObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::cv-23l-3036/site/*"
    },
    {
      "Sid": "AWSLambdaBasicExecutionRolePermissions",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
